# Copy this file to ".env" and change the values.
PORT=3001
# A long random text. Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Keep true while this is a demo with synthetic data (shows the UNOFFICIAL banner everywhere).
DEMO_MODE=true
# Where the web app runs (comma separated)
CORS_ORIGINS=http://localhost:5173
MAX_IMAGE_MB=6
# Optional: reading the sheet photo with AI (leave empty to type the numbers by hand)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
